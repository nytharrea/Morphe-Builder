# GitHub API/release
GITHUB_TOKEN=
GITHUB_REPOSITORY=

# Build target: all veya config.py içindeki app key
TARGET_APP=all

# Kendi keystore'un (workflow secret'larıyla aynı isimler)
KS_PATH=Panemi.keystore
KS_PASSWORD=
KS_ALIAS=
KEY_PASSWORD=

# Güvenlik: release workflow'unda true olmalı; eksik keystore'da testkey'e düşmez
REQUIRE_CUSTOM_KEYSTORE=true

# Sürüm seçimi: max_patches_then_version | latest_compatible
VERSION_POLICY=max_patches_then_version

# Eski release'lerden kaç tanesi tutulsun (0 eski davranış: diğer hepsi silinir)
RELEASE_KEEP_LATEST=3

# İsteğe bağlı asset SHA-256 sabitleme dosyası
PINNED_ASSETS_PATH=data/pinned_assets.json

# Bildirimler - boş bırakılırsa notification gönderilmez
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
APPRISE_URLS=
